{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "confidence-audit threshold export",
  "description": "exports/thresholds.json -- consumed by Project 1 and Project 3.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["task", "model", "tau_low", "tau_high", "target", "date", "run_id"],
    "additionalProperties": false,
    "properties": {
      "task": { "type": "string" },
      "model": { "type": "string" },
      "tau_low": { "type": "number", "minimum": 0, "maximum": 1 },
      "tau_high": { "type": "number", "minimum": 0, "maximum": 1 },
      "target": {
        "type": "object",
        "required": ["coverage", "error_rate"],
        "additionalProperties": false,
        "properties": {
          "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
          "error_rate": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      },
      "date": { "type": "string", "format": "date" },
      "run_id": { "type": "string" }
    }
  }
}
